---
interface Props {
  id: string;
  number: string;
  title: string;
  summary?: string;
  tone?: 'default' | 'accent' | 'quiet';
}

const { id, number, title, summary, tone = 'default' } = Astro.props;

const headingId = `${id}-heading`;
---

<section
  id={id}
  class:list={['case-study-section', `case-study-section--${tone}`]}
  aria-labelledby={headingId}
>
  <header class="case-study-section__header">
    <p class="case-study-section__number">
      <span class="sr-only">Section </span>{number}
    </p>
    <div>
      <h2 id={headingId}>{title}</h2>
      {summary && <p class="case-study-section__summary">{summary}</p>}
    </div>
  </header>

  <div class="case-study-section__content">
    <slot />
  </div>
</section>

<style>
  .case-study-section {
    scroll-margin-top: 6.5rem;
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding-block: clamp(3.75rem, 8vw, 7rem);
    border-top: 1px solid var(--color-border, rgba(166, 214, 222, 0.18));
  }

  .case-study-section--accent {
    position: relative;
  }

  .case-study-section--accent::before {
    position: absolute;
    inset: -1px auto auto 0;
    width: min(12rem, 36%);
    height: 2px;
    content: '';
    background: var(--color-accent, #5ce1d8);
  }

  .case-study-section--quiet {
    color: var(--color-text-muted, #a9bbc4);
  }

  .case-study-section__header {
    align-self: start;
  }

  .case-study-section__number {
    margin: 0 0 1rem;
    color: var(--color-accent, #5ce1d8);
    font-family: var(--font-mono, ui-monospace, 'Cascadia Code', monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-text, #edf8fa);
    font-size: clamp(1.75rem, 3vw, 2.65rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .case-study-section__summary {
    max-width: 34rem;
    margin: 1.15rem 0 0;
    color: var(--color-text-muted, #a9bbc4);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
  }

  .case-study-section__content {
    min-width: 0;
  }

  @media (max-width: 52rem) {
    .case-study-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    h2 {
      max-width: 24ch;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .case-study-section:target .case-study-section__number {
      animation: target-pulse 520ms ease-out;
    }
  }

  @keyframes target-pulse {
    50% {
      color: var(--color-text, #edf8fa);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
