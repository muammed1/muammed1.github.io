---
import { getEntry } from 'astro:content';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const [siteEntry, profileEntry] = await Promise.all([
  getEntry('site', 'site'),
  getEntry('profile', 'profile'),
]);

if (!siteEntry) {
  throw new Error('Missing required site content entry "site".');
}

if (!profileEntry) {
  throw new Error('Missing required profile content entry "profile".');
}

const site = siteEntry.data;
const profile = profileEntry.data;

const navItems = [
  { label: site.navigation.about, href: isHome ? '#about' : '/#about' },
  { label: site.navigation.experience, href: isHome ? '#experience' : '/#experience' },
  { label: site.navigation.skills, href: isHome ? '#skills' : '/#skills' },
  { label: site.navigation.work, href: '/projects/' },
  { label: site.navigation.contact, href: isHome ? '#contact' : '/#contact' },
  { label: site.navigation.resume, href: '/resume/' },
];
---

<header class="site-header" data-site-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${profile.name}, home`}>
      <span class="brand-mark" aria-hidden="true">{profile.initials}</span>
      <span class="brand-copy">
        <strong>{profile.name}</strong>
        <span>{site.brandRole}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
      aria-label="Open navigation"
      data-nav-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="Primary navigation" data-nav>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  item.href === '/projects/'
                    ? pathname.startsWith('/projects/')
                      ? 'page'
                      : undefined
                    : item.href === pathname
                      ? 'page'
                      : undefined
                }
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  const closeNavigation = () => {
    if (!header || !toggle) return;
    header.dataset.open = 'false';
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open navigation');
  };

  toggle?.addEventListener('click', () => {
    if (!header) return;
    const open = header.dataset.open !== 'true';
    header.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  });

  nav?.querySelectorAll('[data-nav-link]').forEach((link) => {
    link.addEventListener('click', closeNavigation);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeNavigation();
      toggle?.focus();
    }
  });

  const mediaQuery = window.matchMedia('(min-width: 56rem)');
  mediaQuery.addEventListener('change', (event) => {
    if (event.matches) closeNavigation();
  });
</script>
