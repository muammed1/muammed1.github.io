---
import { getEntry } from 'astro:content';

const year = new Date().getFullYear();

const [siteEntry, profileEntry] = await Promise.all([
  getEntry('site', 'site'),
  getEntry('profile', 'profile'),
]);

if (!siteEntry) {
  throw new Error('Missing required site content entry "site".');
}

if (!profileEntry) {
  throw new Error('Missing required profile content entry "profile".');
}

const site = siteEntry.data;
const profile = profileEntry.data;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="footer-brand" href="/" aria-label={`${profile.name}, home`}>{profile.initials}</a>
      <p>{site.footerTagline}</p>
    </div>
    <div class="footer-meta">
      <p>© {year} {profile.name}</p>
      <a href="#main-content">{site.backToTopLabel} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
