---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  initials: string;
  roles: string[];
  headline: string;
  valueProposition: string;
  availability: string;
  email: string;
  primaryAction?: {
    label: string;
    href: string;
  };
  resumeActionLabel: string;
  contactActionLabel: string;
  actionsAriaLabel: string;
  factsAriaLabel: string;
  facts: {
    label: string;
    value: string;
  }[];
  visualLabel: string;
  visualTopLabel: string;
  visualBottomLabel: string;
  portrait?: {
    image: ImageMetadata;
    alt: string;
  };
}

const {
  name,
  initials,
  roles,
  headline,
  valueProposition,
  availability,
  email,
  primaryAction,
  resumeActionLabel,
  contactActionLabel,
  actionsAriaLabel,
  factsAriaLabel,
  facts,
  visualLabel,
  visualTopLabel,
  visualBottomLabel,
  portrait,
} = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span class="status-dot" aria-hidden="true"></span>
        {availability}
      </p>
      <h1 id="hero-title">
        <span>{name}</span>
        {headline}
      </h1>
      <p class="hero-role">{roles.join(' / ')}</p>
      <p class="hero-intro">{valueProposition}</p>
      <div class="hero-actions" aria-label={actionsAriaLabel}>
        {
          primaryAction && (
            <a class="button button--primary" href={primaryAction.href}>
              {primaryAction.label}
              <span aria-hidden="true">↗</span>
            </a>
          )
        }
        <a class="button button--secondary" href="/resume/">{resumeActionLabel}</a>
        <a class="text-link" href={`mailto:${email}`}>{contactActionLabel}</a>
      </div>
      <dl class="hero-facts" aria-label={factsAriaLabel}>
        {
          facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-visual" aria-hidden={portrait ? undefined : 'true'}>
      <div class:list={['monogram-card', { 'monogram-card--portrait': portrait }]}>
        {
          portrait ? (
            <Image
              class="hero-portrait"
              src={portrait.image}
              alt={portrait.alt}
              widths={[320, 480, 640]}
              sizes="(max-width: 56rem) 80vw, 25rem"
              loading="eager"
              fetchpriority="high"
            />
          ) : (
            <>
              <div class="monogram-orbit monogram-orbit--one" />
              <div class="monogram-orbit monogram-orbit--two" />
              <span class="monogram">{initials}</span>
            </>
          )
        }
        <div aria-hidden="true">
          <span class="monogram-label">{visualLabel}</span>
          <span class="coordinate coordinate--top">{visualTopLabel}</span>
          <span class="coordinate coordinate--bottom">{visualBottomLabel}</span>
        </div>
      </div>
    </div>
  </div>
</section>
