---
interface Props {
  name: string;
  roles: string[];
  headline: string;
  valueProposition: string;
  availability: string;
  email: string;
}

const { name, roles, headline, valueProposition, availability, email } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">
        <span class="status-dot" aria-hidden="true"></span>
        {availability}
      </p>
      <h1 id="hero-title">
        <span>{name}</span>
        {headline}
      </h1>
      <p class="hero-role">{roles.join(' / ')}</p>
      <p class="hero-intro">{valueProposition}</p>
      <div class="hero-actions" aria-label="Portfolio actions">
        <a class="button button--primary" href="/projects/gymbo/">
          View Gymbo case study
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--secondary" href="/resume/">View resume</a>
        <a class="text-link" href={`mailto:${email}`}>Contact me</a>
      </div>
      <dl class="hero-facts" aria-label="Professional overview">
        <div>
          <dt>Experience</dt>
          <dd>Professional software delivery · 2023–2026</dd>
        </div>
        <div>
          <dt>Core</dt>
          <dd>PHP · Laravel · relational databases</dd>
        </div>
        <div>
          <dt>Focus</dt>
          <dd>Backend systems · business workflows</dd>
        </div>
      </dl>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="monogram-card">
        <div class="monogram-orbit monogram-orbit--one"></div>
        <div class="monogram-orbit monogram-orbit--two"></div>
        <span class="monogram">MZ</span>
        <span class="monogram-label">Software Engineer</span>
        <span class="coordinate coordinate--top">PHP / LARAVEL</span>
        <span class="coordinate coordinate--bottom">BACKEND / SYSTEMS</span>
      </div>
    </div>
  </div>
</section>
