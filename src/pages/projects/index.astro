---
import { getCollection, getEntry } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const [homeEntry, projectEntries] = await Promise.all([
  getEntry('home', 'home'),
  getCollection('projects'),
]);

if (!homeEntry) {
  throw new Error('Missing required home content entry "home".');
}

const page = homeEntry.data.projectsPage;
const projects = projectEntries
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));

const statusLabels = {
  deployed: 'Deployed',
  'in-development': 'In development',
  archived: 'Archived',
} as const;
---

<BaseLayout title={page.title} description={page.description} canonicalPath="/projects/">
  <section class="page-hero" aria-labelledby="projects-title">
    <div class="container page-hero__inner">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1 id="projects-title">{page.heading}</h1>
      <p class="page-hero__lede">{page.description}</p>
    </div>
  </section>

  <section class="section--compact section--surface" aria-label={page.eyebrow}>
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="projects-list">
            {projects.map((project, index) => (
              <ProjectCard
                title={project.data.title}
                role={project.data.role}
                summary={project.data.summary}
                status={statusLabels[project.data.status]}
                capabilities={project.data.capabilities}
                href={`/projects/${project.id}/`}
                privacy={project.data.privacy}
                featured={project.data.featured}
                index={index + 1}
                cover={project.data.cover}
              />
            ))}
          </div>
        ) : (
          <p class="notice" role="status">
            {page.emptyMessage}
          </p>
        )
      }
    </div>
  </section>

  <style>
    .projects-list {
      display: grid;
      gap: clamp(1.5rem, 4vw, 3rem);
    }
  </style>
</BaseLayout>
