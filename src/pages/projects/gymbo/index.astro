---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudySection from '../../../components/CaseStudySection.astro';
import Diagram from '../../../components/Diagram.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

const project = await getEntry('projects', 'gymbo');

if (!project) {
  throw new Error('The Gymbo project content entry is required for this page.');
}

const projectData = project.data;
const pageTitle = `${projectData.title} engineering case study | Mohammad Zeno`;
const pageDescription =
  'A documentation-led case study of Gymbo’s membership, financial, reporting, and Dahua biometric attendance workflows.';

const sections = [
  ['overview', 'Project overview'],
  ['business-context', 'Business context'],
  ['contribution', 'Contribution boundary'],
  ['functional-scope', 'Functional scope'],
  ['system-structure', 'System structure'],
  ['data-reporting', 'Data and reporting'],
  ['engineering-decisions', 'Engineering decisions'],
  ['biometric-integration', 'Biometric integration'],
  ['challenges', 'Challenges and trade-offs'],
  ['status', 'Results and current status'],
  ['privacy', 'Privacy and source availability'],
  ['related-skills', 'Related skills'],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Gymbo engineering case study',
  description: pageDescription,
  author: {
    '@type': 'Person',
    name: 'Mohammad Zeno',
    url: 'https://muammed1.github.io/',
  },
  mainEntityOfPage: 'https://muammed1.github.io/projects/gymbo/',
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/projects/gymbo/"
  type="article"
  {jsonLd}
  pageClass="gymbo-case-study"
>
  <article class="case-study">
    <header class="case-hero">
      <div class="case-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/#work">Selected work</a></li>
            <li aria-current="page">Gymbo</li>
          </ol>
        </nav>

        <div class="case-hero__grid">
          <div class="case-hero__copy">
            <p class="case-kicker">
              {projectData.title} · {projectData.privacy} business-systems project
            </p>
            <h1>
              Gym operations, financial rules, and biometric attendance—one documented system.
            </h1>
            <p class="case-hero__lede">
              Gymbo is documented as a centralized web application for subscriber, membership,
              pricing, financial, attendance, locker, trainer, dashboard, and reporting workflows.
            </p>

            <div class="case-hero__actions">
              <a class="button button--primary" href="#system-structure">
                Explore the system structure
              </a>
              <a class="button button--secondary" href="/#work"> Back to selected work </a>
            </div>

            <ul class="case-labels" aria-label="Project disclosure">
              <li>Private source</li>
              <li>No fabricated screenshots</li>
              <li>Documentation-led account</li>
            </ul>
          </div>

          <aside class="case-snapshot" aria-labelledby="snapshot-title">
            <p class="case-snapshot__eyebrow">Evidence snapshot</p>
            <h2 id="snapshot-title">What the sources support</h2>
            <dl>
              <div>
                <dt>Product</dt>
                <dd>{projectData.summary}</dd>
              </div>
              <div>
                <dt>Contribution</dt>
                <dd>Engineering involvement; exact role unverified</dd>
              </div>
              <div>
                <dt>Structure</dt>
                <dd>Modular monolithic web application</dd>
              </div>
              <div>
                <dt>Data</dt>
                <dd>Relational records and reporting views</dd>
              </div>
              <div>
                <dt>Integration</dt>
                <dd>Dahua biometric attendance devices</dd>
              </div>
              <div>
                <dt>Availability</dt>
                <dd>Private; implementation artifacts unavailable</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <div class="case-shell">
      <section class="evidence-disclosure">
        <SectionHeading
          eyebrow="Evidence policy"
          title="A technical walkthrough, not a reconstructed product demo"
          description="This case study uses the most conservative wording supported by the available project documentation. Source code, a verified schema, production runbooks, and sanitized interface screenshots were not available for public inspection."
        />
        <p class="evidence-disclosure__note">
          The diagrams below are original architecture and workflow illustrations. They are not
          product screenshots, deployment diagrams, or a detailed ERD.
        </p>
      </section>

      <nav class="case-toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {
            sections.map(([id, label], index) => (
              <li>
                <a href={`#${id}`}>
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="case-sections">
        <CaseStudySection
          id="overview"
          number="01"
          title="Project overview"
          summary="A connected operational system described through its business rules and data flows—not through an assumed technology stack."
          tone="accent"
        >
          <div class="prose">
            <p class="prose__lead">
              Gymbo brings recurring gym operations into one web-based workflow: people and
              memberships, prices and payments, attendance, physical resources, and management
              reporting.
            </p>
            <p>
              The available evidence describes an application in use, while leaving its exact
              implementation stack and production topology undocumented. This distinction matters:
              the useful engineering story is the way business state moves through the system, not
              an unsupported framework or infrastructure label.
            </p>
          </div>

          <div class="two-up">
            <article class="info-card">
              <p class="info-card__label">Documented</p>
              <h3>Operational breadth</h3>
              <p>
                Subscriber, subscription, pricing, finance, attendance, locker, trainer, dashboard,
                report, and permission concerns are described at a high level.
              </p>
            </article>
            <article class="info-card info-card--quiet">
              <p class="info-card__label">Not established</p>
              <h3>Implementation specifics</h3>
              <p>
                Language, framework, database engine, hosting, API contracts, deployment topology,
                and test coverage are not claimed here.
              </p>
            </article>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="business-context"
          number="02"
          title="Business context"
          summary="Membership operations are interconnected: a change in one area can affect financial state, attendance eligibility, and reporting."
        >
          <div class="prose">
            <p>
              A gym-management system is more than a directory of members. A subscription carries a
              price at a point in time; a charge changes the member’s financial position; a payment
              changes it again; and an attendance event must be associated with the correct internal
              person.
            </p>
            <p>
              Gymbo’s documented rules connect these concerns while preserving traceability. Rather
              than storing only a mutable balance or replacing old prices, the system is described
              in terms of financial movements and historical price versions.
            </p>
          </div>

          <ol class="logic-chain" aria-label="Connected business events">
            <li>
              <span>Subscription</span>
              <strong>Creates a debit record</strong>
              <p>The charge contributes to a balance derived from ledger entries.</p>
            </li>
            <li>
              <span>Payment</span>
              <strong>Creates a credit record</strong>
              <p>The new movement contributes to the same calculated balance.</p>
            </li>
            <li>
              <span>Price change</span>
              <strong>Creates historical separation</strong>
              <p>Existing subscriptions retain their documented price version.</p>
            </li>
          </ol>
        </CaseStudySection>

        <CaseStudySection
          id="contribution"
          number="03"
          title="Contribution boundary"
          summary="The sources document engineering concerns and decisions, but do not reliably establish an exact title or feature-by-feature ownership."
        >
          <div class="boundary-note">
            <p class="boundary-note__label">Evidence boundary</p>
            <h3>Exact project role not asserted</h3>
            <p>
              Public-safe records support engineering involvement with the system. They do not
              provide enough evidence to publish a precise project title or assign individual
              features to one contributor.
            </p>
          </div>

          <div class="prose">
            <p>
              Within that boundary, the documented work concerns business-rule clarity, historical
              data correctness, relational reporting, and external-device integration. This page
              does not assign every design decision solely to one person.
            </p>
            <p>
              It also avoids unsupported claims of sole authorship, team leadership, or exclusive
              subsystem ownership. A more granular responsibility map should be published only when
              repository history or a contribution record can be safely disclosed.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="functional-scope"
          number="04"
          title="Functional scope"
          summary="The documented surface spans daily administration, commercial records, physical resources, and management information."
        >
          <div class="capability-grid">
            <article class="capability">
              <span aria-hidden="true">01</span>
              <h3>Subscribers and memberships</h3>
              <p>Subscriber records, membership types, durations, and subscription management.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">02</span>
              <h3>Pricing history</h3>
              <p>
                Versioned pricing is described as preserving the value attached to a historical
                subscription.
              </p>
            </article>
            <article class="capability">
              <span aria-hidden="true">03</span>
              <h3>Financial records</h3>
              <p>Debit and credit movements support a ledger-derived member balance.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">04</span>
              <h3>Attendance</h3>
              <p>Internal attendance records are synchronized from Dahua biometric device logs.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">05</span>
              <h3>Resources and staff</h3>
              <p>Locker and trainer management are included in the described operational scope.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">06</span>
              <h3>Decision support</h3>
              <p>Dashboards, reports, database views, and optional PDF or Excel export.</p>
            </article>
          </div>

          <p class="scope-footnote">
            These capabilities are described as implemented in narrative sources; code-level
            verification is unavailable. Role-based permissions are documented only at a high level,
            without a publishable permission matrix.
          </p>
        </CaseStudySection>

        <CaseStudySection
          id="system-structure"
          number="05"
          title="System structure"
          summary="A modular monolith coordinates web workflows, relational persistence, reporting views, and a dedicated hardware-integration boundary."
          tone="accent"
        >
          <div class="prose">
            <p>
              The case-study material characterizes Gymbo as a modular monolithic web application.
              Operational business functions run through an application layer, state is held in a
              relational database, and reporting projections are provided through database views.
            </p>
            <p>
              Dahua attendance synchronization is described behind a dedicated service layer.
              “Dedicated” describes responsibility separation; it does not establish an
              independently deployed microservice.
            </p>
          </div>

          <Diagram
            src="/assets/diagrams/gymbo-system-context.svg"
            alt="Gymbo system context: users access a web application that applies business rules and stores operational records in a relational database. Reporting views support dashboards and PDF or Excel exports. Dahua attendance devices connect through a dedicated integration service layer."
            caption="High-level system context reconstructed from documented boundaries. Technology choices and deployment topology are deliberately excluded."
            width={1200}
            height={760}
          />

          <div class="claim-boundary">
            <strong>Architecture boundary</strong>
            <p>
              The evidence does not support microservices, Clean Architecture, Domain-Driven Design,
              or event-driven architecture labels.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="data-reporting"
          number="06"
          title="Data and reporting design"
          summary="Operational records and reporting projections have distinct responsibilities, while historical and financial rules protect meaning over time."
        >
          <div class="prose">
            <p>
              Project sources report a relational model with 23 tables and 15 database views. Those
              counts provide scale context only: table names, columns, keys, constraints, indexes,
              and view definitions are not available, so this page intentionally avoids a
              speculative ERD.
            </p>
          </div>

          <div class="data-patterns">
            <article>
              <p class="pattern-index">A</p>
              <div>
                <h3>Operational records</h3>
                <p>
                  Hold day-to-day state across subscriber, subscription, pricing, finance,
                  attendance, locker, trainer, and user/role domains.
                </p>
              </div>
            </article>
            <article>
              <p class="pattern-index">B</p>
              <div>
                <h3>Reporting views</h3>
                <p>
                  Provide report-oriented projections for screens and optional PDF/Excel output
                  without redefining operational state.
                </p>
              </div>
            </article>
            <article>
              <p class="pattern-index">C</p>
              <div>
                <h3>Derived financial balance</h3>
                <p>
                  Subscription debits and payment credits contribute traceable movements from which
                  balance is calculated.
                </p>
              </div>
            </article>
            <article>
              <p class="pattern-index">D</p>
              <div>
                <h3>Historical price integrity</h3>
                <p>
                  Price versioning prevents a current-price update from rewriting the value
                  associated with an earlier subscription.
                </p>
              </div>
            </article>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="engineering-decisions"
          number="07"
          title="Engineering decisions"
          summary="The strongest documented decisions favor traceability, historical correctness, and explicit domain safeguards."
        >
          <div class="decision-list">
            <article>
              <p class="decision-list__type">Financial model</p>
              <h3>Derive balance from movements</h3>
              <p>
                Keep debit and credit events as the source of the calculated balance instead of
                presenting a balance as an unexplained mutable number.
              </p>
              <small> Refund, reversal, discount, and correction behavior is undocumented. </small>
            </article>
            <article>
              <p class="decision-list__type">Temporal correctness</p>
              <h3>Version prices</h3>
              <p>
                Preserve the price context of an existing subscription when the current offer
                changes.
              </p>
              <small> Version activation, locking, and manual overrides are undocumented. </small>
            </article>
            <article>
              <p class="decision-list__type">Integration safety</p>
              <h3>Persist attendance idempotently</h3>
              <p>
                Use first-or-create behavior so polling the same device event again should not
                create another attendance record.
              </p>
              <small>The exact deduplication identity key is undocumented.</small>
            </article>
            <article>
              <p class="decision-list__type">Domain integrity</p>
              <h3>Reject conflicting assignments</h3>
              <p>
                The sources describe rules preventing overlapping subscriptions and conflicting
                locker assignments.
              </p>
              <small>Conditions, exception paths, and enforcement layers are unavailable.</small>
            </article>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="biometric-integration"
          number="08"
          title="Biometric device integration"
          summary="A polling workflow translates hardware identities into internal attendance records while guarding against duplicate ingestion."
          tone="accent"
        >
          <div class="prose">
            <p>
              The documented flow reaches a Dahua device, polls its raw attendance logs, maps each
              device user to an internal subscriber, persists the event idempotently, and evaluates
              or flags subscription eligibility.
            </p>
            <p>
              This is an identity and data-quality boundary as much as a hardware boundary: external
              identifiers and repeated observations must resolve to stable internal records.
            </p>
          </div>

          <Diagram
            src="/assets/diagrams/gymbo-attendance-flow.svg"
            alt="Six-step attendance workflow: reach a Dahua device, poll raw logs, map the device user to an internal subscriber, persist the attendance record idempotently, evaluate subscription eligibility, and make the record available to reporting."
            caption="Attendance synchronization and reporting flow. Polling is documented; real-time delivery and physical gate control are not."
            width={1200}
            height={820}
          />

          <div class="claim-boundary claim-boundary--warning">
            <strong>Integration boundary</strong>
            <p>
              Device models, protocol or SDK, authentication, polling schedule, retry strategy,
              clock synchronization, provisioning, network topology, and physical access control are
              undocumented.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="challenges"
          number="09"
          title="Challenges and trade-offs"
          summary="The sources reveal practical tensions even where implementation details remain private."
        >
          <div
            class="challenge-table"
            role="region"
            aria-labelledby="challenge-table-title"
            tabindex="0"
          >
            <table>
              <caption id="challenge-table-title">
                Documented engineering challenges and responses
              </caption>
              <thead>
                <tr>
                  <th scope="col">Engineering tension</th>
                  <th scope="col">Documented response</th>
                  <th scope="col">Known boundary</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">The same device log may be observed again</th>
                  <td>First-or-create, idempotent persistence</td>
                  <td>Deduplication key and timestamp policy unavailable</td>
                </tr>
                <tr>
                  <th scope="row">A device identity differs from a business identity</th>
                  <td>Map the device user to an internal subscriber</td>
                  <td>Provisioning and mismatch recovery unavailable</td>
                </tr>
                <tr>
                  <th scope="row">Prices change while history must remain stable</th>
                  <td>Associate subscriptions with a price version</td>
                  <td>Activation and override rules unavailable</td>
                </tr>
                <tr>
                  <th scope="row">Operational storage and report reading have different needs</th>
                  <td>Use database views for reporting projections</td>
                  <td>View definitions and refresh behavior unavailable</td>
                </tr>
                <tr>
                  <th scope="row">Assignments can conflict across time or resources</th>
                  <td>Reject subscription overlap and locker conflicts</td>
                  <td>Validation and transaction boundaries unavailable</td>
                </tr>
              </tbody>
            </table>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="status"
          number="10"
          title="Results and current status"
          summary="The credible result is a documented operational capability set; numerical impact and infrastructure maturity are not inferred."
        >
          <div class="status-grid">
            <article>
              <p class="status-grid__state status-grid__state--supported">Supported</p>
              <h3>Connected operational workflows</h3>
              <p>
                The sources describe subscriber, membership, financial, attendance, resource,
                dashboard, and reporting capabilities in one system.
              </p>
            </article>
            <article>
              <p class="status-grid__state">Partially documented</p>
              <h3>Production status</h3>
              <p>
                Materials describe deployed use, but no independently verifiable adoption metric or
                client inventory is presented here.
              </p>
            </article>
            <article>
              <p class="status-grid__state">Undocumented</p>
              <h3>Operational topology</h3>
              <p>
                Hosting, environments, tenancy, release, rollback, backup, and recovery procedures
                are not available.
              </p>
            </article>
            <article>
              <p class="status-grid__state">Not claimed</p>
              <h3>Quality metrics</h3>
              <p>
                No public performance, availability, traffic, security, or test coverage guarantees
                are inferred.
              </p>
            </article>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="privacy"
          number="11"
          title="Privacy and source availability"
          summary="The production interface and implementation remain private, so the portfolio distinguishes evidence from illustration."
          tone="quiet"
        >
          <div class="privacy-panel">
            <div>
              <p class="privacy-panel__label">What is shown</p>
              <ul class="check-list">
                <li>Conservative summaries of documented capabilities</li>
                <li>Original high-level architecture and workflow diagrams</li>
                <li>Explicit limits wherever implementation evidence is absent</li>
              </ul>
            </div>
            <div>
              <p class="privacy-panel__label">What is withheld or unavailable</p>
              <ul class="check-list check-list--muted">
                <li>Private source code and proprietary implementation detail</li>
                <li>Production data, client-sensitive information, and credentials</li>
                <li>Unverified screenshots, detailed schema, and deployment topology</li>
              </ul>
            </div>
          </div>

          <div class="prose">
            <p>
              No synthetic dashboard is presented as product evidence. If sanitized screenshots
              become available, they can be added later with a clear caption and provenance. Until
              then, the diagrams remain deliberately abstract and non-deceptive.
            </p>
            <p>
              Deeper technical publication would require a verified schema or migrations, API
              contracts, device documentation, operating runbooks, and a publishable contribution
              record.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="related-skills"
          number="12"
          title="Related engineering skills"
          summary="These are project themes evidenced by the documentation, not a claim that every global profile skill or technology was used in Gymbo."
          tone="accent"
        >
          <ul class="skill-themes" aria-label="Engineering themes represented in Gymbo">
            <li>
              <span>01</span>
              <strong>Business-rule modeling</strong>
              <p>
                Translate subscriptions, payments, eligibility, and conflicts into explicit
                behavior.
              </p>
            </li>
            <li>
              <span>02</span>
              <strong>Relational data reasoning</strong>
              <p>Separate durable operational state from report-oriented projections.</p>
            </li>
            <li>
              <span>03</span>
              <strong>Historical correctness</strong>
              <p>Preserve prior commercial meaning as current pricing changes.</p>
            </li>
            <li>
              <span>04</span>
              <strong>Systems integration</strong>
              <p>Map an external device identity into a consistent internal attendance record.</p>
            </li>
            <li>
              <span>05</span>
              <strong>Idempotent ingestion</strong>
              <p>Make repeated polling safe against duplicate event persistence.</p>
            </li>
            <li>
              <span>06</span>
              <strong>Evidence-conscious communication</strong>
              <p>
                Explain architecture without filling private or undocumented gaps with assumptions.
              </p>
            </li>
          </ul>

          <div class="case-next">
            <div>
              <p class="case-kicker">Continue exploring</p>
              <h3>See the broader professional context.</h3>
            </div>
            <div class="case-next__actions">
              <a class="button button--primary" href="/#experience">View experience</a>
              <a class="button button--secondary" href="/resume/">View resume</a>
            </div>
          </div>
        </CaseStudySection>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    --case-border: var(--color-border, rgba(166, 214, 222, 0.18));
    --case-surface: var(--color-surface, #0b1b27);
    --case-surface-raised: var(--color-surface-raised, #102530);
    --case-text: var(--color-text, #eef8fa);
    --case-muted: var(--color-text-muted, #a9bbc4);
    --case-accent: var(--color-accent, #5ce1d8);
    --case-accent-soft: var(--color-accent-soft, rgba(92, 225, 216, 0.11));
    color: var(--case-text);
  }

  .case-shell {
    width: min(72rem, calc(100% - clamp(2rem, 7vw, 6rem)));
    margin-inline: auto;
  }

  .case-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 4.25rem) clamp(4rem, 10vw, 8rem);
    border-bottom: 1px solid var(--case-border);
  }

  .case-hero::before {
    position: absolute;
    z-index: -1;
    inset: 4rem -10rem auto auto;
    width: 32rem;
    height: 32rem;
    content: '';
    border: 1px solid rgba(92, 225, 216, 0.12);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(92, 225, 216, 0.08), transparent 67%);
  }

  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    padding: 0;
    margin: 0 0 clamp(3rem, 7vw, 6rem);
    color: var(--case-muted);
    font-size: 0.875rem;
    list-style: none;
  }

  .breadcrumbs li:not(:last-child)::after {
    margin-left: 0.45rem;
    color: rgba(169, 187, 196, 0.55);
    content: '/';
  }

  .breadcrumbs a {
    color: inherit;
    text-underline-offset: 0.25em;
  }

  .breadcrumbs a:hover {
    color: var(--case-accent);
  }

  .case-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.42fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
  }

  .case-kicker {
    margin: 0 0 1.2rem;
    color: var(--case-accent);
    font-family: var(--font-mono, ui-monospace, 'Cascadia Code', monospace);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 17ch;
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 5.9rem);
    line-height: 0.97;
    letter-spacing: -0.062em;
