---
import { getEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudySection from '../../../components/CaseStudySection.astro';
import Diagram from '../../../components/Diagram.astro';
import SectionHeading from '../../../components/SectionHeading.astro';

const project = await getEntry('projects', 'gymbo');

if (!project) {
  throw new Error('The Gymbo project content entry is required for this page.');
}

const projectData = project.data;
const pageTitle = `${projectData.title} engineering case study | Mohammad Zeno`;
const pageDescription =
  'A documentation-led case study of Gymboâ€™s membership, financial, reporting, and Dahua biometric attendance workflows.';

const sections = [
  ['overview', 'Project overview'],
  ['business-context', 'Business context'],
  ['contribution', 'Contribution boundary'],
  ['functional-scope', 'Functional scope'],
  ['system-structure', 'System structure'],
  ['data-reporting', 'Data and reporting'],
  ['engineering-decisions', 'Engineering decisions'],
  ['biometric-integration', 'Biometric integration'],
  ['challenges', 'Challenges and trade-offs'],
  ['status', 'Results and current status'],
  ['privacy', 'Privacy and source availability'],
  ['related-skills', 'Related skills'],
] as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Gymbo engineering case study',
  description: pageDescription,
  author: {
    '@type': 'Person',
    name: 'Mohammad Zeno',
    url: 'https://muammed1.github.io/',
  },
  mainEntityOfPage: 'https://muammed1.github.io/projects/gymbo/',
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/projects/gymbo/"
  type="article"
  {jsonLd}
  pageClass="gymbo-case-study"
>
  <article class="case-study">
    <header class="case-hero">
      <div class="case-shell">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/#work">Selected work</a></li>
            <li aria-current="page">Gymbo</li>
          </ol>
        </nav>

        <div class="case-hero__grid">
          <div class="case-hero__copy">
            <p class="case-kicker">
              {projectData.title} Â· {projectData.privacy} business-systems project
            </p>
            <h1>
              Gym operations, financial rules, and biometric attendanceâ€”one documented system.
            </h1>
            <p class="case-hero__lede">
              Gymbo is documented as a centralized web application for subscriber, membership,
              pricing, financial, attendance, locker, trainer, dashboard, and reporting workflows.
            </p>

            <div class="case-hero__actions">
              <a class="button button--primary" href="#system-structure">
                Explore the system structure
              </a>
              <a class="button button--secondary" href="/#work"> Back to selected work </a>
            </div>

            <ul class="case-labels" aria-label="Project disclosure">
              <li>Private source</li>
              <li>No fabricated screenshots</li>
              <li>Documentation-led account</li>
            </ul>
          </div>

          <aside class="case-snapshot" aria-labelledby="snapshot-title">
            <p class="case-snapshot__eyebrow">Evidence snapshot</p>
            <h2 id="snapshot-title">What the sources support</h2>
            <dl>
              <div>
                <dt>Product</dt>
                <dd>{projectData.summary}</dd>
              </div>
              <div>
                <dt>Contribution</dt>
                <dd>Engineering involvement; exact role unverified</dd>
              </div>
              <div>
                <dt>Structure</dt>
                <dd>Modular monolithic web application</dd>
              </div>
              <div>
                <dt>Data</dt>
                <dd>Relational records and reporting views</dd>
              </div>
              <div>
                <dt>Integration</dt>
                <dd>Dahua biometric attendance devices</dd>
              </div>
              <div>
                <dt>Availability</dt>
                <dd>Private; implementation artifacts unavailable</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </header>

    <div class="case-shell">
      <section class="evidence-disclosure">
        <SectionHeading
          eyebrow="Evidence policy"
          title="A technical walkthrough, not a reconstructed product demo"
          description="This case study uses the most conservative wording supported by the available project documentation. Source code, a verified schema, production runbooks, and sanitized interface screenshots were not available for public inspection."
        />
        <p class="evidence-disclosure__note">
          The diagrams below are original architecture and workflow illustrations. They are not
          product screenshots, deployment diagrams, or a detailed ERD.
        </p>
      </section>

      <nav class="case-toc" aria-label="On this page">
        <p>On this page</p>
        <ol>
          {
            sections.map(([id, label], index) => (
              <li>
                <a href={`#${id}`}>
                  <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                  {label}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="case-sections">
        <CaseStudySection
          id="overview"
          number="01"
          title="Project overview"
          summary="A connected operational system described through its business rules and data flowsâ€”not through an assumed technology stack."
          tone="accent"
        >
          <div class="prose">
            <p class="prose__lead">
              Gymbo brings recurring gym operations into one web-based workflow: people and
              memberships, prices and payments, attendance, physical resources, and management
              reporting.
            </p>
            <p>
              The available evidence describes an application in use, while leaving its exact
              implementation stack and production topology undocumented. This distinction matters:
              the useful engineering story is the way business state moves through the system, not
              an unsupported framework or infrastructure label.
            </p>
          </div>

          <div class="two-up">
            <article class="info-card">
              <p class="info-card__label">Documented</p>
              <h3>Operational breadth</h3>
              <p>
                Subscriber, subscription, pricing, finance, attendance, locker, trainer, dashboard,
                report, and permission concerns are described at a high level.
              </p>
            </article>
            <article class="info-card info-card--quiet">
              <p class="info-card__label">Not established</p>
              <h3>Implementation specifics</h3>
              <p>
                Language, framework, database engine, hosting, API contracts, deployment topology,
                and test coverage are not claimed here.
              </p>
            </article>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="business-context"
          number="02"
          title="Business context"
          summary="Membership operations are interconnected: a change in one area can affect financial state, attendance eligibility, and reporting."
        >
          <div class="prose">
            <p>
              A gym-management system is more than a directory of members. A subscription carries a
              price at a point in time; a charge changes the memberâ€™s financial position; a payment
              changes it again; and an attendance event must be associated with the correct internal
              person.
            </p>
            <p>
              Gymboâ€™s documented rules connect these concerns while preserving traceability. Rather
              than storing only a mutable balance or replacing old prices, the system is described
              in terms of financial movements and historical price versions.
            </p>
          </div>

          <ol class="logic-chain" aria-label="Connected business events">
            <li>
              <span>Subscription</span>
              <strong>Creates a debit record</strong>
              <p>The charge contributes to a balance derived from ledger entries.</p>
            </li>
            <li>
              <span>Payment</span>
              <strong>Creates a credit record</strong>
              <p>The new movement contributes to the same calculated balance.</p>
            </li>
            <li>
              <span>Price change</span>
              <strong>Creates historical separation</strong>
              <p>Existing subscriptions retain their documented price version.</p>
            </li>
          </ol>
        </CaseStudySection>

        <CaseStudySection
          id="contribution"
          number="03"
          title="Contribution boundary"
          summary="The sources document engineering concerns and decisions, but do not reliably establish an exact title or feature-by-feature ownership."
        >
          <div class="boundary-note">
            <p class="boundary-note__label">Evidence boundary</p>
            <h3>Exact project role not asserted</h3>
            <p>
              Public-safe records support engineering involvement with the system. They do not
              provide enough evidence to publish a precise project title or assign individual
              features to one contributor.
            </p>
          </div>

          <div class="prose">
            <p>
              Within that boundary, the documented work concerns business-rule clarity, historical
              data correctness, relational reporting, and external-device integration. This page
              does not assign every design decision solely to one person.
            </p>
            <p>
              It also avoids unsupported claims of sole authorship, team leadership, or exclusive
              subsystem ownership. A more granular responsibility map should be published only when
              repository history or a contribution record can be safely disclosed.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="functional-scope"
          number="04"
          title="Functional scope"
          summary="The documented surface spans daily administration, commercial records, physical resources, and management information."
        >
          <div class="capability-grid">
            <article class="capability">
              <span aria-hidden="true">01</span>
              <h3>Subscribers and memberships</h3>
              <p>Subscriber records, membership types, durations, and subscription management.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">02</span>
              <h3>Pricing history</h3>
              <p>
                Versioned pricing is described as preserving the value attached to a historical
                subscription.
              </p>
            </article>
            <article class="capability">
              <span aria-hidden="true">03</span>
              <h3>Financial records</h3>
              <p>Debit and credit movements support a ledger-derived member balance.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">04</span>
              <h3>Attendance</h3>
              <p>Internal attendance records are synchronized from Dahua biometric device logs.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">05</span>
              <h3>Resources and staff</h3>
              <p>Locker and trainer management are included in the described operational scope.</p>
            </article>
            <article class="capability">
              <span aria-hidden="true">06</span>
              <h3>Decision support</h3>
              <p>Dashboards, reports, database views, and optional PDF or Excel export.</p>
            </article>
          </div>

          <p class="scope-footnote">
            These capabilities are described as implemented in narrative sources; code-level
            verification is unavailable. Role-based permissions are documented only at a high level,
            without a publishable permission matrix.
          </p>
        </CaseStudySection>

        <CaseStudySection
          id="system-structure"
          number="05"
          title="System structure"
          summary="A modular monolith coordinates web workflows, relational persistence, reporting views, and a dedicated hardware-integration boundary."
          tone="accent"
        >
          <div class="prose">
            <p>
              The case-study material characterizes Gymbo as a modular monolithic web application.
              Operational business functions run through an application layer, state is held in a
              relational database, and reporting projections are provided through database views.
            </p>
            <p>
              Dahua attendance synchronization is described behind a dedicated service layer.
              â€œDedicatedâ€ describes responsibility separation; it does not establish an
              independently deployed microservice.
            </p>
          </div>

          <Diagram
            src="/assets/diagrams/gymbo-system-context.svg"
            alt="Gymbo system context: users access a web application that applies business rules and stores operational records in a relational database. Reporting views support dashboards and PDF or Excel exports. Dahua attendance devices connect through a dedicated integration service layer."
            caption="High-level system context reconstructed from documented boundaries. Technology choices and deployment topology are deliberately excluded."
            width={1200}
            height={760}
          />

          <div class="claim-boundary">
            <strong>Architecture boundary</strong>
            <p>
              The evidence does not support microservices, Clean Architecture, Domain-Driven Design,
              or event-driven architecture labels.
            </p>
          </div>
        </CaseStudySection>

        <CaseStudySection
          id="data-reporting"
          number="06"
          title="Data and reporting design"
          summary="Operational records and reporting projections have distinct responsibilities, while historical and financial rules protect meaning over time."
        >
