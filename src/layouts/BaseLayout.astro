---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  pageClass?: string;
}

const {
  title,
  description,
  canonicalPath,
  image,
  imageAlt,
  type,
  noindex,
  jsonLd,
  pageClass = '',
} = Astro.props;

const [siteEntry, profileEntry] = await Promise.all([
  getEntry('site', 'site'),
  getEntry('profile', 'profile'),
]);

if (!siteEntry || !profileEntry) {
  throw new Error('Required site and profile content entries are missing.');
}

const site = siteEntry.data;
const profile = profileEntry.data;
const selectedSocialImage = image ?? site.socialPreview?.image;
const optimizedSocialImage = selectedSocialImage
  ? await getImage({
      src: selectedSocialImage,
      width: 1200,
      height: 630,
      fit: 'cover',
      position: 'center',
      format: 'png',
    })
  : undefined;
const socialImage = optimizedSocialImage?.src ?? '/social-preview.png';
const socialImageAlt =
  imageAlt ??
  site.socialPreview?.alt ??
  `${profile.name} — ${profile.roles.slice(0, 2).join(' and ')}`;
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08111f" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO
      {title}
      {description}
      {canonicalPath}
      image={socialImage}
      {type}
      {noindex}
      {jsonLd}
      siteUrl={site.siteUrl}
      siteName={site.siteName}
      imageAlt={socialImageAlt}
    />
    <slot name="head" />
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
